{
  "name": "monexamenligne-desktop",
  "productName": "MonExamEnLigne",
  "version": "1.2.6",
  "description": "MonExamEnLigne — Collège Champagneur (examen verrouillé)",
  "main": "main.js",
  "author": "Collège Champagneur",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis msi"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.monexamenligne.desktop",
    "productName": "MonExamEnLigne",
    "files": ["main.js", "preload.js", "config.json"],
    "win": { "target": ["nsis", "msi"], "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "perMachine": true, "allowToChangeInstallationDirectory": true, "shortcutName": "MonExamEnLigne" },
    "msi": { "oneClick": true, "perMachine": true, "createDesktopShortcut": true, "shortcutName": "MonExamEnLigne", "upgradeCode": "8C3E6B1A-4F2D-4B7E-9A51-6D2F0C7B3E19" }
  }
}
